# Example environment file — copy to .env and fill in. NEVER commit the real .env.
#
# This app deliberately needs no API keys. Everything runs locally with
# yt-dlp + ffmpeg. The variables below are optional tuning knobs.

# Port the server listens on (default 8000)
PORT=8000

# Optional: a cookies export lets yt-dlp fetch age-restricted or
# members-only videos. Export from your browser with:
#   yt-dlp --cookies-from-browser firefox --cookies cookies.txt <url>
# then point this at the file (and keep cookies.txt OUT of git).
# YT_COOKIES_FILE=./cookies.txt
